# Copy this file to .env and fill in your actual values
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
GEMINI_API_KEY=your_gemini_api_key_here

# Max Gemini-consuming actions (item enrichment, search embedding, chat) per user per day.
# Bounds your Gemini spend regardless of how many people use the app. Defaults to 50.
GEMINI_DAILY_QUOTA_PER_USER=50

# Object storage for uploaded document originals (S3-compatible: Cloudflare R2, AWS S3, MinIO).
# Required only for file uploads; URL bookmarks work without it. R2's free tier (10GB, no egress) is ideal.
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_BUCKET=your_bucket_name
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=auto

# Document ingestion tuning (all optional — sensible defaults shown).
MAX_UPLOAD_MB=20
MAX_CHUNKS_PER_DOC=200
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP=100

# Auth — choose ONE of the two options below:
# Option A (production/Render): set the RSA public key from Clerk dashboard
CLERK_PEM_PUBLIC_KEY=your_clerk_pem_public_key_here

# Option B (local dev, simpler): use Clerk's JWKS endpoint directly
# Find it at: https://dashboard.clerk.com → API Keys → Advanced → JWKS URL
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
