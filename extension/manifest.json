{
  "manifest_version": 3,
  "name": "AI Bookmark Vault Capture",
  "version": "1.0.0",
  "description": "Save the current page to your AI Bookmark Vault from any tab.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to AI Bookmark Vault"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "storage", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
